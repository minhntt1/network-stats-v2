<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.home.netstats.v2.common.stats.mapper.DeviceDimMapper">


    <!-- countAll --> 

    <select id="countAll">
        select count(*)
        from device_dim
    </select>    

    <!-- findAll --> 

    <select id="findAllPagination">
        select *
        from device_dim
        order by device_key
        limit #{limit}
        offset #{offset}
    </select>

</mapper>